{
  "name": "goop",
  "version": "0.0.0",
  "private": true,
  "description": "Local job search agent for developers: finds offers, matches them against your CV and chats with you, all with local models.",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun scripts/dev-env/run.ts bun --watch src/main.ts",
    "test": "bun scripts/dev-env/run.ts bun test",
    "typecheck": "bun scripts/dev-env/run.ts tsc --noEmit",
    "lint": "bun scripts/dev-env/run.ts biome check .",
    "format": "bun scripts/dev-env/run.ts biome format --write .",
    "build": "bun scripts/dev-env/run.ts bun build --compile src/main.ts --outfile dist/goop",
    "clean": "bun scripts/dev-env/clean.ts",
    "clean:local": "bun scripts/dev-env/clean.ts --local",
    "native-libs:build": "bun scripts/dev-env/run.ts bun scripts/native-libs/cli.ts",
    "sandbox:install": "bun scripts/dev-env/run.ts bun scripts/sandbox/cli.ts install",
    "sandbox:run": "bun scripts/dev-env/run.ts bun scripts/sandbox/cli.ts run",
    "sandbox:status": "bun scripts/dev-env/run.ts bun scripts/sandbox/cli.ts status",
    "sandbox:test": "bun scripts/dev-env/run.ts bun scripts/sandbox/cli.ts test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/bun": "1.4.4",
    "husky": "9.1.7",
    "typescript": "7.0.2"
  }
}
