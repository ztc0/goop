# The sqlite3mc win32-x64 build image (odd/tasks/native-library.md, S3): the same pinned Debian 13
# base and snapshot as ../linux-x64/, with the pinned mingw-w64 that cross-compiles sqlite3mc.dll.
# DEBIAN_IMAGE, APT_SNAPSHOT and WIN32_TOOLCHAIN in ../recipe.ts hold the same values, and a test
# keeps them equal. The win32 thread model needs no winpthread DLL: SQLite uses Win32 threads.
FROM docker.io/library/debian:trixie@sha256:e2914ec98e08b24b4cee3cefcb9f90dfb5519f8d215a2ccf0c9a49b10b6e43de

# Packages come from the Debian snapshot the base image was made from, so their versions cannot
# move. apt checks the archive's signature with the keyring in the base image; plain http keeps
# ca-certificates out of it, and the snapshot's Release files are past their Valid-Until date
# by design. snapshot.debian.org often answers 503 or 504 under load, so apt retries.
RUN rm /etc/apt/sources.list.d/debian.sources \
 && printf '%s\n' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261027T000000Z trixie main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20261027T000000Z trixie-updates main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20261027T000000Z trixie-security main' \
      > /etc/apt/sources.list \
 && apt-get -o Acquire::Retries=8 update \
 && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=8 install -y --no-install-recommends \
      gcc-mingw-w64-x86-64-win32=14.2.0-19+27+b1 \
      gcc-mingw-w64-x86-64-win32-runtime=14.2.0-19+27+b1 \
      gcc-mingw-w64-base=14.2.0-19+27+b1 \
      binutils-mingw-w64-x86-64=2.44-3+12+b1 \
      mingw-w64-x86-64-dev=12.0.0-5 \
      mingw-w64-common=12.0.0-5 \
      unzip=6.0-29+deb13u1 \
 && rm -rf /var/lib/apt/lists/*
